#!/bin/bash
# Stub for /usr/bin/security, used by scripts/test-hermes-supervisor.sh so the
# real keychain (and its password dialogs) is never touched. Records every
# argv to $MOE_STUB_LOG, one call per line, and answers:
#   find-generic-password -s <svc> -w   → prints $MOE_STUB_TOKEN, exit 0, when
#                                          <svc> == $MOE_STUB_PRESENT_SVC;
#                                          else exit 44 (errSecItemNotFound)
#   add-generic-password / delete-generic-password → exit 0
#   find-identity                       → prints $MOE_STUB_IDENTITIES (one
#                                          identity per line, as the real
#                                          tool formats them) or "0 valid
#                                          identities found"; exit 0.
#                                          Used by scripts/test-release.sh.
printf '%s\n' "$*" >> "${MOE_STUB_LOG:-/dev/null}"
case "${1:-}" in
  find-generic-password)
    svc=""
    while [ $# -gt 0 ]; do
      if [ "$1" = -s ]; then svc="$2"; shift; fi
      shift
    done
    if [ -n "$svc" ] && [ "$svc" = "${MOE_STUB_PRESENT_SVC:-}" ]; then
      printf '%s\n' "${MOE_STUB_TOKEN:-stub-token}"
      exit 0
    fi
    echo "security: SecKeychainSearchCopyNext: The specified item could not be found in the keychain." >&2
    exit 44
    ;;
  add-generic-password|delete-generic-password)
    exit 0
    ;;
  find-identity)
    if [ -n "${MOE_STUB_IDENTITIES:-}" ]; then
      echo "Policy: Code Signing"
      echo "  Matching identities"
      printf '%s\n' "$MOE_STUB_IDENTITIES"
    else
      echo "Policy: Code Signing"
      echo "  Matching identities"
      echo "     0 valid identities found"
    fi
    exit 0
    ;;
  *)
    echo "stub security: unexpected subcommand: $*" >&2
    exit 2
    ;;
esac
